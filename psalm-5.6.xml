<?xml version="1.0"?>
<psalm autoloader="tests/bootstrap.php"
       stopOnFirstError="false"
       totallyTyped="true"
       strictBinaryOperands="true">
    <projectFiles>
        <directory name="src" />
        <directory name="tests" />
        <ignoreFiles>
            <directory name="vendor" />
            <file name="src/Logger/ConsoleLogger/ConsoleLogger80.php" />
        </ignoreFiles>
    </projectFiles>
    <fileExtensions>
        <extension name="php" filetypeHandler="rules/AllRule56.php" />
    </fileExtensions>
</psalm>
